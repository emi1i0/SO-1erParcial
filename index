<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SO · Práctica 1er Parcial</title>
<meta name="description" content="Cuestionario interactivo para practicar el 1er parcial de Sistemas Operativos (UTN FRRe), armado a partir de revisiones de parciales anteriores con respuestas verificadas.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%2314352b'/><text x='50%25' y='56%25' text-anchor='middle' dominant-baseline='middle' font-family='monospace' font-size='28' font-weight='700' fill='%23f2c14e'>SO</text></svg>">
<style>
:root{
  --bg:#f4f1ea; --surface:#fffdf8; --surface-2:#efeadf; --ink:#1d2421; --ink-2:#4b554f; --muted:#7a827c;
  --line:#ddd6c8; --accent:#14532d; --accent-ink:#ffffff; --accent-soft:#dfeee3;
  --ok:#1f7a45; --ok-soft:#e1f3e7; --bad:#b4372f; --bad-soft:#fbe6e3; --warn:#9a5b00; --warn-soft:#fff1d6;
  --hl:#f2c14e; --shadow:0 1px 2px rgba(30,30,20,.06),0 6px 24px rgba(30,30,20,.06);
  --radius:14px; --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace; --sans:"IBM Plex Sans",system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0f1412; --surface:#161d1a; --surface-2:#1e2723; --ink:#e7ece8; --ink-2:#b4bfb8; --muted:#86918a;
    --line:#2b3632; --accent:#7fd19b; --accent-ink:#0f1412; --accent-soft:#1d3327;
    --ok:#6fd497; --ok-soft:#173225; --bad:#ff8a7e; --bad-soft:#3a1d1a; --warn:#f2c14e; --warn-soft:#352a12;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.25);
  }
}
:root[data-theme="dark"]{
  --bg:#0f1412; --surface:#161d1a; --surface-2:#1e2723; --ink:#e7ece8; --ink-2:#b4bfb8; --muted:#86918a;
  --line:#2b3632; --accent:#7fd19b; --accent-ink:#0f1412; --accent-soft:#1d3327;
  --ok:#6fd497; --ok-soft:#173225; --bad:#ff8a7e; --bad-soft:#3a1d1a; --warn:#f2c14e; --warn-soft:#352a12;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.25);
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;min-height:100vh}
button,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
a{color:var(--accent)}
.wrap{max-width:860px;margin:0 auto;padding:0 16px}
header.top{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
header.top .wrap{display:flex;align-items:center;gap:12px;height:56px}
.brand{font-family:var(--mono);font-weight:600;letter-spacing:-.02em;display:flex;align-items:center;gap:8px;background:none;border:0;padding:0;font-size:15px}
.brand .dot{width:10px;height:10px;border-radius:3px;background:var(--hl);box-shadow:0 0 0 3px color-mix(in srgb,var(--hl) 30%,transparent)}
.brand b{color:var(--accent)}
.spacer{flex:1}
.icon-btn{border:1px solid var(--line);background:var(--surface);border-radius:10px;height:36px;min-width:36px;padding:0 10px;display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:14px;color:var(--ink-2)}
.icon-btn:hover{border-color:var(--ink-2)}
main{padding:24px 0 80px}

/* HOME */
.hero{padding:16px 0 8px}
.kicker{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
h1{font-size:clamp(28px,5vw,40px);line-height:1.1;letter-spacing:-.02em;margin:6px 0 10px}
h1 em{font-style:normal;background:linear-gradient(transparent 62%,color-mix(in srgb,var(--hl) 55%,transparent) 62%)}
.lede{color:var(--ink-2);max-width:62ch;margin:0}
.stats-strip{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 6px}
.pill{font-family:var(--mono);font-size:12.5px;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:4px 10px;color:var(--ink-2)}
.pill b{color:var(--ink)}
.modes{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:22px 0}
.mode{text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);transition:transform .12s, border-color .12s;display:flex;flex-direction:column;gap:6px;min-height:132px}
.mode:hover{transform:translateY(-2px);border-color:var(--accent)}
.mode:disabled{opacity:.5;cursor:not-allowed;transform:none}
.mode .t{font-weight:600;font-size:17px;display:flex;align-items:center;gap:8px}
.mode .d{color:var(--ink-2);font-size:14px}
.mode .tag{font-family:var(--mono);font-size:11px;color:var(--accent);margin-top:auto}
.mode.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.mode.primary .d,.mode.primary .tag{color:color-mix(in srgb,var(--accent-ink) 82%,transparent)}
.panel{border:1px solid var(--line);background:var(--surface);border-radius:var(--radius);padding:16px;margin:12px 0}
.panel h3{margin:0 0 10px;font-size:14px;font-family:var(--mono);font-weight:500;color:var(--ink-2);letter-spacing:.02em;display:flex;justify-content:space-between;align-items:center}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--line);background:var(--surface-2);border-radius:999px;padding:6px 12px;font-size:14px;display:inline-flex;align-items:center;gap:6px}
.chip .n{font-family:var(--mono);font-size:12px;color:var(--muted)}
.chip[aria-pressed="true"]{background:var(--accent-soft);border-color:var(--accent);color:var(--ink)}
.chip[aria-pressed="true"] .n{color:var(--accent)}
.linkish{background:none;border:0;color:var(--accent);font-size:13px;padding:0;font-family:var(--mono)}
.opts-row{display:flex;flex-wrap:wrap;gap:18px;align-items:center}
.toggle{display:inline-flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;user-select:none}
.toggle input{appearance:none;width:38px;height:22px;border-radius:999px;background:var(--line);position:relative;transition:background .15s;margin:0;cursor:pointer;flex:none}
.toggle input::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:var(--surface);transition:left .15s;box-shadow:0 1px 2px rgba(0,0,0,.2)}
.toggle input:checked{background:var(--accent)}
.toggle input:checked::after{left:19px}
.sel{border:1px solid var(--line);background:var(--surface-2);border-radius:10px;padding:6px 10px;font-size:14px}
.topic-stats{display:grid;grid-template-columns:1fr;gap:6px;font-size:13.5px}
.ts-row{display:grid;grid-template-columns:minmax(120px,190px) 1fr 52px;gap:10px;align-items:center}
.bar{height:8px;border-radius:99px;background:var(--surface-2);overflow:hidden}
.bar > i{display:block;height:100%;background:var(--accent);border-radius:99px}
.ts-row .v{font-family:var(--mono);font-size:12px;color:var(--muted);text-align:right}
.foot{color:var(--muted);font-size:13px;margin-top:28px;border-top:1px dashed var(--line);padding-top:14px}

/* QUIZ */
.qtop{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.counter{font-family:var(--mono);font-size:13px;color:var(--ink-2)}
.progress{height:4px;background:var(--surface-2);border-radius:99px;overflow:hidden;margin:0 0 16px}
.progress > i{display:block;height:100%;background:var(--accent);transition:width .25s}
.score-badge{font-family:var(--mono);font-size:12.5px;padding:3px 9px;border-radius:999px;background:var(--surface);border:1px solid var(--line)}
.timer{font-family:var(--mono);font-size:13px;padding:3px 9px;border-radius:999px;background:var(--warn-soft);color:var(--warn)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px}
.meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
.tag2{font-family:var(--mono);font-size:11.5px;padding:2px 8px;border-radius:6px;background:var(--surface-2);color:var(--ink-2);border:1px solid var(--line)}
.tag2.freq{background:color-mix(in srgb,var(--hl) 22%,var(--surface));border-color:color-mix(in srgb,var(--hl) 60%,var(--line));color:var(--ink)}
.tag2.fix{background:var(--warn-soft);border-color:color-mix(in srgb,var(--warn) 40%,var(--line));color:var(--warn)}
.qtext{font-size:17.5px;font-weight:500;margin:6px 0 4px;line-height:1.45}
.hint{font-size:13px;color:var(--muted);margin:0 0 14px;font-family:var(--mono)}
.ctx{margin:0 0 14px}
.ctx p{margin:0 0 10px;color:var(--ink-2);font-size:15px}
.muted{color:var(--muted)}
pre.code,pre.flow{font-family:var(--mono);font-size:13.5px;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:12px 14px;overflow-x:auto;margin:0 0 12px;line-height:1.5;white-space:pre}
.tables{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-start;margin-bottom:6px}
table.dt{border-collapse:collapse;font-family:var(--mono);font-size:13.5px;margin:0 0 10px;background:var(--surface)}
table.dt caption{font-family:var(--sans);font-size:12px;color:var(--muted);text-align:left;padding-bottom:4px}
table.dt th,table.dt td{border:1px solid var(--line);padding:4px 10px;text-align:center}
table.dt th{background:var(--surface-2);font-weight:500;color:var(--ink-2)}
.ws{overflow-x:auto;margin-bottom:12px}
.ws-row{display:flex;gap:4px;font-family:var(--mono);padding-bottom:22px}
.ws-row span{width:26px;height:30px;flex:none;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:6px;background:var(--surface-2);position:relative;font-size:14px}
.ws-row span.t::after{position:absolute;top:34px;font-size:11px;color:var(--accent);font-weight:600}
.ws-row span.t{border-color:var(--accent)}
.ws-row span.t1::after{content:"t1"} .ws-row span.t2::after{content:"t2"} .ws-row span.t3::after{content:"t3"}
.ws-row span.t2{background:var(--accent-soft)}
.options{display:flex;flex-direction:column;gap:8px}
.opt{display:flex;gap:12px;align-items:flex-start;text-align:left;width:100%;border:1.5px solid var(--line);background:var(--surface);border-radius:12px;padding:11px 13px;transition:border-color .1s, background .1s;line-height:1.45;font-size:15.5px}
.opt:hover:not(:disabled){border-color:var(--ink-2)}
.opt .k{flex:none;width:24px;height:24px;border-radius:7px;border:1.5px solid var(--line);display:inline-flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:12px;color:var(--muted);margin-top:1px}
.opt.multi .k{border-radius:6px}
.opt.single .k{border-radius:50%}
.opt[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft)}
.opt[aria-pressed="true"] .k{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.opt:disabled{cursor:default}
.opt.is-ok{border-color:var(--ok);background:var(--ok-soft)}
.opt.is-ok .k{background:var(--ok);border-color:var(--ok);color:#fff}
.opt.is-bad{border-color:var(--bad);background:var(--bad-soft)}
.opt.is-bad .k{background:var(--bad);border-color:var(--bad);color:#fff}
.opt.is-missed{border-style:dashed;border-color:var(--ok)}
.opt .lab{flex:1}
.opt .mk{font-family:var(--mono);font-size:12px;font-weight:600;flex:none;margin-top:2px}
.opt.is-ok .mk{color:var(--ok)} .opt.is-bad .mk{color:var(--bad)} .opt.is-missed .mk{color:var(--ok)}
.match{display:flex;flex-direction:column;gap:10px}
.mrow{display:grid;grid-template-columns:1fr minmax(150px,220px);gap:12px;align-items:center;border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:var(--surface)}
.mrow .l{font-size:15px}
.mrow select,.cloze select{border:1.5px solid var(--line);background:var(--surface-2);border-radius:9px;padding:7px 10px;width:100%;font-size:14.5px}
.mrow.is-ok{border-color:var(--ok);background:var(--ok-soft)} .mrow.is-bad{border-color:var(--bad);background:var(--bad-soft)}
.mrow .fix{grid-column:1/-1;font-size:13px;color:var(--ok);font-family:var(--mono)}
.cloze{font-size:16px;line-height:2.3}
.cloze select{width:auto;display:inline-block;margin:0 2px}
.cloze select.is-ok{border-color:var(--ok);background:var(--ok-soft)} .cloze select.is-bad{border-color:var(--bad);background:var(--bad-soft)}
textarea.ans{width:100%;min-height:120px;border:1.5px solid var(--line);background:var(--surface-2);border-radius:12px;padding:12px;resize:vertical;font-size:15px;line-height:1.5}
.model{border-left:3px solid var(--accent);background:var(--accent-soft);padding:12px 14px;border-radius:0 10px 10px 0;margin-top:12px;font-size:15px}
.model p{margin:0 0 8px} .model p:last-child{margin:0}
.model table.dt{margin:6px 0 10px}
.self{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;align-items:center}
.self span{font-size:14px;color:var(--ink-2);margin-right:4px}
.fb{margin-top:16px;border-radius:12px;padding:14px 16px;font-size:15px;border:1px solid}
.fb.ok{background:var(--ok-soft);border-color:color-mix(in srgb,var(--ok) 35%,transparent)}
.fb.bad{background:var(--bad-soft);border-color:color-mix(in srgb,var(--bad) 35%,transparent)}
.fb.part{background:var(--warn-soft);border-color:color-mix(in srgb,var(--warn) 35%,transparent)}
.fb .h{font-weight:600;margin-bottom:4px;display:flex;align-items:center;gap:8px}
.fb.ok .h{color:var(--ok)} .fb.bad .h{color:var(--bad)} .fb.part .h{color:var(--warn)}
.fb p{margin:0}
.note{margin-top:10px;border-radius:12px;padding:12px 14px;font-size:14.5px;background:var(--warn-soft);border:1px dashed color-mix(in srgb,var(--warn) 50%,transparent)}
.note .h{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--warn);letter-spacing:.04em;text-transform:uppercase;margin-bottom:3px}
.actions{display:flex;gap:10px;margin-top:16px;align-items:center;flex-wrap:wrap}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:11px;padding:10px 16px;font-weight:500;font-size:15px;display:inline-flex;align-items:center;gap:8px}
.btn:hover:not(:disabled){border-color:var(--ink-2)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.primary:hover:not(:disabled){filter:brightness(1.08)}
.btn.ghost{background:transparent}
.btn.sm{padding:6px 12px;font-size:14px;border-radius:9px}
.kbd{font-family:var(--mono);font-size:11px;border:1px solid currentColor;border-radius:4px;padding:0 4px;opacity:.65}
.grid-nav{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}
.grid-nav button{width:36px;height:34px;border-radius:8px;border:1px solid var(--line);background:var(--surface);font-family:var(--mono);font-size:12.5px;color:var(--ink-2)}
.grid-nav button.ans{background:var(--accent-soft);border-color:var(--accent);color:var(--ink)}
.grid-nav button.cur{outline:2px solid var(--accent);outline-offset:1px}
.grid-nav button.ok{background:var(--ok-soft);border-color:var(--ok);color:var(--ok)}
.grid-nav button.bad{background:var(--bad-soft);border-color:var(--bad);color:var(--bad)}
.grid-nav button.part{background:var(--warn-soft);border-color:var(--warn);color:var(--warn)}

/* RESULTS */
.res-head{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.big{font-family:var(--mono);font-size:64px;font-weight:600;line-height:1;letter-spacing:-.04em}
.big small{font-size:22px;color:var(--muted);font-weight:500}
.res-list{display:flex;flex-direction:column;gap:6px;margin-top:10px}
.res-item{display:flex;gap:10px;align-items:flex-start;text-align:left;width:100%;border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:9px 12px;font-size:14.5px}
.res-item .s{font-family:var(--mono);font-size:12px;flex:none;width:44px;text-align:right;margin-top:2px}
.res-item .s.ok{color:var(--ok)} .res-item .s.bad{color:var(--bad)} .res-item .s.part{color:var(--warn)}
.res-item .tt{flex:1;color:var(--ink-2);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.empty{text-align:center;padding:40px 16px;color:var(--ink-2)}

@media (max-width:680px){
  .modes{grid-template-columns:1fr}
  .mode{min-height:auto}
  .mrow{grid-template-columns:1fr}
  .card{padding:16px}
  .qtext{font-size:16.5px}
  .ts-row{grid-template-columns:110px 1fr 44px}
  .actions .btn{flex:1;justify-content:center}
  .hide-sm{display:none}
}
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <button class="brand" id="homeBtn" title="Inicio"><span class="dot"></span>SO<b>://</b>parcial1</button>
  <div class="spacer"></div>
  <button class="icon-btn" id="themeBtn" title="Cambiar tema" aria-label="Cambiar tema"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg></button>
</div></header>
<main><div class="wrap" id="app"></div></main>

<script>
// Banco de preguntas — Sistemas Operativos, 1er Parcial (UTN FRRe)
// Fuente: revisiones de parciales 2015–2024 y autoevaluaciones de la cátedra.
// tipos: single | multi | tf | match | cloze | open
const TEMAS = {
  intro: "Introducción",
  proc: "Procesos y planificación",
  hilos: "Hilos",
  conc: "Concurrencia",
  dead: "Deadlock",
  mem: "Particiones",
  pag: "Paginación y MV",
  reem: "Reemplazo de páginas",
};

const PAGE_TABLE = `<table class="dt"><thead><tr><th>Página</th><th>Cargada</th><th>Última ref.</th><th>R</th><th>M</th></tr></thead><tbody>
<tr><td>0</td><td>126</td><td>279</td><td>0</td><td>0</td></tr>
<tr><td>1</td><td>230</td><td>260</td><td>1</td><td>0</td></tr>
<tr><td>2</td><td>120</td><td>272</td><td>1</td><td>1</td></tr>
<tr><td>3</td><td>160</td><td>280</td><td>1</td><td>1</td></tr></tbody></table>`;

const PART_Q3 = `<p>Particiones fijas de <b>200 Kb, 100 Kb y 50 Kb</b>. Cola única con recorrido de cola, criterio <b>mejor partición en la que cabe</b>. Planificación <b>Round Robin q=3</b>. TA = arribo a la cola de Nuevos.</p>
<table class="dt"><thead><tr><th></th><th>TA</th><th>TI</th><th>Tamaño</th></tr></thead><tbody>
<tr><td>P1</td><td>0</td><td>4</td><td>150</td></tr><tr><td>P2</td><td>0</td><td>4</td><td>60</td></tr>
<tr><td>P3</td><td>2</td><td>4</td><td>75</td></tr><tr><td>P4</td><td>3</td><td>2</td><td>40</td></tr></tbody></table>`;

const PART_Q4 = `<p>Igual que el anterior (particiones 200/100/50 Kb, mejor ajuste, cola única con recorrido) pero con <b>Round Robin q=4</b> y P1 con TI=3.</p>
<table class="dt"><thead><tr><th></th><th>TA</th><th>TI</th><th>Tamaño</th></tr></thead><tbody>
<tr><td>P1</td><td>0</td><td>3</td><td>150</td></tr><tr><td>P2</td><td>0</td><td>4</td><td>60</td></tr>
<tr><td>P3</td><td>2</td><td>4</td><td>75</td></tr><tr><td>P4</td><td>3</td><td>2</td><td>40</td></tr></tbody></table>`;

const PART_160 = `<p>Particiones fijas de <b>200 Kb, 100 Kb y 160 Kb</b>. Cola única con recorrido de cola. Planificación <b>Round Robin q=2</b>.</p>
<table class="dt"><thead><tr><th></th><th>TA</th><th>TI</th><th>Tamaño</th></tr></thead><tbody>
<tr><td>P1</td><td>0</td><td>8</td><td>150</td></tr><tr><td>P2</td><td>0</td><td>5</td><td>120</td></tr>
